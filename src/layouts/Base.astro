---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Companion from '../components/Companion.astro';
import { SITE } from '../lib/site';

interface Props {
  title?: string;
  /** Search-result title; the brand is appended when the result stays within ~65 characters. */
  seoTitle?: string;
  /** Social share title (og:title / twitter:title). */
  ogTitle?: string;
  description?: string;
  image?: string;
  article?: { published: Date; updated?: Date; section?: string; tags?: string[]; aiWritten?: boolean };
}
const { title, seoTitle, ogTitle, description = SITE.description, image: imageProp, article } = Astro.props;
const image = imageProp ?? '/og-default.png';
const base = seoTitle ?? title;
const branded = base ? `${base} | ${SITE.name}` : '';
const fullTitle = !base ? `${SITE.name}: ${SITE.tagline}` : branded.length <= 65 ? branded : base;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
// Cloudflare Web Analytics (free, cookieless). The beacon token is a public site ID that appears in
// every page's HTML, so it lives in code; PUBLIC_CF_BEACON_TOKEN overrides it. Remove both to switch off.
const beacon = import.meta.env.PUBLIC_CF_BEACON_TOKEN || 'd7787fbfb61e4b039b04565c9910c96e';
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0b0f1a" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={ogTitle ?? title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle ?? title ?? SITE.name} />
    {article?.section && <meta property="article:section" content={article.section} />}
    {article?.tags?.map((t) => <meta property="article:tag" content={t} />)}
    {
      article && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify({
            '@context': 'https://schema.org',
            '@type': 'BlogPosting',
            headline: title,
            ...(ogTitle && { alternativeHeadline: ogTitle }),
            description,
            image: [ogImage.href],
            datePublished: article.published.toISOString(),
            dateModified: (article.updated ?? article.published).toISOString(),
            ...(article.section && { articleSection: article.section }),
            ...(article.tags?.length && { keywords: article.tags.join(', ') }),
            mainEntityOfPage: canonical.href,
            // AI-written posts credit the publication (Art is not a person); Shub's own series credit him.
            author: article.aiWritten ? { '@type': 'Organization', name: SITE.name, url: new URL('/', Astro.site).href } : { '@type': 'Person', name: SITE.author },
            ...(article.aiWritten && { editor: { '@type': 'Person', name: SITE.author } }),
            publisher: { '@type': 'Organization', name: SITE.name, url: new URL('/', Astro.site).href },
          })}
        />
      )
    }
    <script is:inline>
      // Apply the saved theme before paint so the page never flashes.
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-surface focus:px-3 focus:py-2">Skip to content</a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <Companion />
    {beacon && (
      <script defer is:inline src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: beacon })}></script>
    )}
  </body>
</html>
