---
import Base from '../../layouts/Base.astro';
import { formatDate } from '../../lib/format';
import { getRankedPicks, MAX_PICKS, PICK_CATEGORY, fmtStars, fmtChange, repoCard, weeklyChange } from '../../lib/picks';

export async function getStaticPaths() {
  const { all } = await getRankedPicks();
  return all.map((p, i) => ({ params: { slug: p.id }, props: { pick: p, rank: i + 1 } }));
}
const { pick, rank } = Astro.props;
const change = weeklyChange(pick);
const d = pick.data;
---
<Base title={`${d.name}: Open-Source AI Pick`} description={d.tagline}>
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6" data-pagefind-body>
    <a href="/picks/" class="font-mono text-sm text-muted hover:text-cyan" data-pagefind-ignore>← All Open-Source AI Picks</a>
    <div class="card mt-6 overflow-hidden">
      <a href={`https://github.com/${d.repo}`} rel="noopener" class="block border-b border-line bg-surface-2">
        <img src={repoCard(pick.id, d.repo)} alt={`GitHub preview card for ${d.repo}`} width="1200" height="600" decoding="async" referrerpolicy="no-referrer" class="aspect-[2/1] h-auto w-full" />
      </a>
      <div class="p-6 sm:p-8">
              <p class="kicker">{PICK_CATEGORY[d.category]}</p>
              <h1 class="mt-2 font-display text-3xl font-bold tracking-tight sm:text-5xl">{d.name}</h1>
              <p class="mt-2 text-lg text-muted">{d.tagline}</p>
              <dl class="mt-5 flex flex-wrap gap-x-6 gap-y-2 font-mono text-xs text-muted" data-pagefind-ignore>
                <div><dt class="inline">Rank </dt><dd class="inline text-ink">#{rank}{rank > MAX_PICKS ? ' (not in the top ' + MAX_PICKS + ')' : ''}</dd></div>
                <div><dt class="inline">Stars </dt><dd class="inline text-ink">{fmtStars(d.stars)}</dd></div>
                {change !== null && <div><dt class="inline">Last 7 days </dt><dd class={change >= 0 ? 'inline text-green' : 'inline text-magenta'}>{fmtChange(change)}</dd></div>}
                <div><dt class="inline">Licence </dt><dd class="inline text-ink">{d.license}</dd></div>
                <div><dt class="inline">Checked </dt><dd class="inline text-ink">{formatDate(d.statsCheckedOn)}</dd></div>
              </dl>

              <h2 class="mt-8 font-display text-lg font-semibold">What it does</h2>
              <p class="mt-2 leading-relaxed">{d.whatItDoes}</p>

              <h2 class="mt-8 font-display text-lg font-semibold">How to use it</h2>
              <p class="mt-1 font-mono text-xs text-muted">Shell: {d.howToUse.shell}</p>
              <ol class="mt-3 space-y-4">
                {d.howToUse.steps.map((s, n) => (
                  <li class="flex gap-3">
                    <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-surface-2 font-mono text-xs text-cyan" aria-hidden="true">{n + 1}</span>
                    <div class="min-w-0 flex-1">
                      <p>{s.text}</p>
                      {s.code && <pre class="mt-2 overflow-x-auto rounded-xl border border-line bg-surface-2 px-4 py-3 font-mono text-sm"><code>{s.code}</code></pre>}
                    </div>
                  </li>
                ))}
              </ol>

              <h2 class="mt-8 font-display text-lg font-semibold">Best practices</h2>
              <ul class="mt-3 list-disc space-y-2 pl-5 marker:text-cyan">
                {d.bestPractices.map((b) => <li class="leading-relaxed">{b}</li>)}
              </ul>

              <h2 class="mt-8 font-display text-lg font-semibold">In the news</h2>
              <ul class="mt-3 space-y-2 text-sm">
                {d.coverage.map((c) => (
                  <li>
                    <span class="font-semibold">{c.publisher}</span>
                    <span class="text-muted"> · {formatDate(c.date)} · </span>
                    <a class="text-cyan hover:underline" href={c.url} rel="noopener">{c.title}</a>
                  </li>
                ))}
              </ul>

              <a
                href={`https://github.com/${d.repo}`}
                rel="noopener"
                class="mt-8 inline-flex items-center gap-2 rounded-lg border border-cyan px-4 py-2 font-mono text-sm text-cyan hover:bg-cyan hover:text-bg"
              >View {d.repo} on GitHub <span aria-hidden="true">→</span></a>
            </div>
    </div>
  </article>
</Base>
