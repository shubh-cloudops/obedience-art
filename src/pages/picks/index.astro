---
import Base from '../../layouts/Base.astro';
import { formatDate } from '../../lib/format';
import { getRankedPicks, MAX_PICKS, PICK_CATEGORY, fmtStars, fmtChange, repoCard, weeklyChange } from '../../lib/picks';
const { shown } = await getRankedPicks();
const checked = shown.reduce((m, p) => (p.data.statsCheckedOn > m ? p.data.statsCheckedOn : m), new Date(0));
---
<Base
  title="Open-Source AI Picks"
  seoTitle="Open-Source AI Picks: top AI GitHub repos explained"
  description="The most-starred open-source AI projects on GitHub, each covered by at least two major tech outlets: what they do, how to use them, and best practices."
>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <p class="kicker">Open-Source AI Picks</p>
    <h1 class="mt-3 font-display text-4xl font-bold tracking-tight">AI you can download, read and run yourself</h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">
      The top {MAX_PICKS} open-source AI projects we cover, ranked by GitHub stars and explained in plain words. A project
      only makes this list after at least two well-known tech outlets have covered it. We track the stars every day, so
      when a new pick arrives, the one with the fewest stars makes way.
    </p>
    <p class="mt-3 font-mono text-xs text-muted">Stars from GitHub · updated {formatDate(checked)}</p>

    <ol class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {shown.map((p, i) => {
        const d = p.data;
        const change = weeklyChange(p);
        return (
          <li>
            <a href={`/picks/${p.id}/`} class="card group flex h-full flex-col overflow-hidden">
              <div class="relative border-b border-line bg-surface-2">
                <img
                  src={repoCard(d.repo)}
                  alt=""
                  width="1200"
                  height="600"
                  loading={i < 3 ? 'eager' : 'lazy'}
                  decoding="async"
                  referrerpolicy="no-referrer"
                  class="aspect-[2/1] h-auto w-full"
                />
                <span class="absolute left-3 top-3 rounded-full bg-bg/85 px-2.5 py-1 font-mono text-xs font-semibold text-cyan backdrop-blur" aria-label={`Rank ${i + 1}`}>#{i + 1}</span>
                <span class="absolute right-3 top-3 flex items-center gap-2 rounded-full bg-bg/85 px-2.5 py-1 font-mono text-xs text-ink backdrop-blur">
                  <span><span class="text-amber" aria-hidden="true">★</span> {fmtStars(d.stars)}<span class="sr-only"> GitHub stars</span></span>
                  {change !== null && (
                    <span class={change >= 0 ? 'text-green' : 'text-magenta'} title="Change in the last 7 days">{fmtChange(change)}/wk</span>
                  )}
                </span>
              </div>
              <div class="flex flex-1 flex-col p-5">
                <p class="kicker">{PICK_CATEGORY[d.category]}</p>
                <h2 class="mt-2 font-display text-2xl font-bold tracking-tight group-hover:text-cyan">{d.name}</h2>
                <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{d.tagline}</p>
                <p class="mt-4 flex items-center justify-between font-mono text-xs text-muted">
                  <span>{d.license}</span>
                  <span class="text-cyan" aria-hidden="true">Read →</span>
                </p>
              </div>
            </a>
          </li>
        );
      })}
    </ol>

    <p class="mt-14 rounded-xl border border-dashed border-line p-4 text-sm text-muted">
      Ranking uses GitHub stars only; it is not a quality score. Always read a project's licence and security notes
      before you install it. Spotted something out of date? <a class="text-cyan hover:underline" href="/corrections/">Tell us</a>.
    </p>
  </section>
</Base>
