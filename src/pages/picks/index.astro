---
import Base from '../../layouts/Base.astro';
import PickTile from '../../components/PickTile.astro';
import { formatDate } from '../../lib/format';
import { getRankedPicks, MAX_PICKS, RISING_MAX_AGE_DAYS, RISING_MIN_STARS } from '../../lib/picks';
const { top, rising } = await getRankedPicks();
const checked = [...top, ...rising].reduce((m, p) => (p.data.statsCheckedOn > m ? p.data.statsCheckedOn : m), new Date(0));
---
<Base
  title="Open-Source AI Picks"
  seoTitle="Open-Source AI Picks: top AI GitHub repos explained"
  description="The most-starred and the fastest-rising open-source AI projects on GitHub, each covered by two tech outlets: what they do and how to use them."
>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <p class="kicker">Open-Source AI Picks</p>
    <h1 class="mt-3 font-display text-4xl font-bold tracking-tight">AI you can download, read and run yourself</h1>
    <p class="mt-4 max-w-2xl text-lg text-muted">
      Open-source AI projects explained in plain words, in two rows: the {MAX_PICKS} most-starred of all time, and new
      projects that are taking off fast. A project only makes this list after at least two well-known tech outlets have
      covered it. We track the stars every day, so the rows update on their own.
    </p>
    <p class="mt-3 font-mono text-xs text-muted">Stars from GitHub · updated {formatDate(checked)}</p>

    <section class="mt-12" aria-labelledby="top-picks">
      <h2 id="top-picks" class="font-display text-2xl font-bold tracking-tight">Top {MAX_PICKS} of all time</h2>
      <p class="mt-1 text-sm text-muted">The most-starred projects on our list.</p>
      <ol class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {top.map((p, i) => <PickTile pick={p} rank={i + 1} eager={i < 3} />)}
      </ol>
    </section>

    {rising.length > 0 && (
      <section class="mt-16" aria-labelledby="rising-picks">
        <h2 id="rising-picks" class="font-display text-2xl font-bold tracking-tight">Rising: new and already popular</h2>
        <p class="mt-1 max-w-2xl text-sm text-muted">
          Projects first published on GitHub in the last {RISING_MAX_AGE_DAYS} days that already have more than
          {' '}{RISING_MIN_STARS.toLocaleString('en-GB')} stars. Each one leaves this row once it is older than {RISING_MAX_AGE_DAYS} days.
        </p>
        <ol class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {rising.map((p, i) => <PickTile pick={p} rank={i + 1} showAge />)}
        </ol>
      </section>
    )}

    <p class="mt-14 rounded-xl border border-dashed border-line p-4 text-sm text-muted">
      Ranking uses GitHub stars only; it is not a quality score. Always read a project's licence and security notes
      before you install it. Spotted something out of date? <a class="text-cyan hover:underline" href="/corrections/">Tell us</a>.
    </p>
  </section>
</Base>
