---
import Base from '../layouts/Base.astro';
import Ambassador from '../components/Ambassador.astro';
---
<Base title="Not found">
  <section data-art="apologetic" data-art-say="I looked exactly where you told me to. Sorry!" class="mx-auto max-w-3xl px-4 py-20 text-center sm:px-6">
    <Ambassador expression="apologetic" size={200} eager class="mx-auto mb-8" />
    <p class="font-mono text-sm text-amber">404: specification not found</p>
    <h1 class="mt-4 font-display text-4xl font-bold">You asked for a page that doesn't exist.</h1>
    <p class="mt-4 text-muted">We did exactly what you asked and looked for it. That's the problem with obedience.</p>
    <a href="/" class="mt-8 inline-block rounded-lg bg-cyan px-5 py-2.5 font-medium text-bg">Back to the start</a>
  </section>
</Base>
