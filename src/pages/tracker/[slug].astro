---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Timeline from '../../components/Timeline.astro';
import { getTrackers, EVENT_TYPES } from '../../lib/events';
import { formatDate } from '../../lib/format';

export async function getStaticPaths() {
  const trackers = await getTrackers();
  return trackers.map((t) => ({ params: { slug: t.id }, props: { tracker: t } }));
}
const { tracker } = Astro.props;
const d = tracker.data;
const related = (await Promise.all(d.relatedPosts.map((id) => getEntry('posts', id)))).filter(Boolean);
const actors = [...new Set(tracker.sorted.map((e) => e.actor))];
const usedTypes = (Object.keys(EVENT_TYPES) as (keyof typeof EVENT_TYPES)[]).filter((k) => tracker.sorted.some((e) => e.type === k));
---
<Base title={d.title} description={d.summary}>
  <article class="mx-auto max-w-3xl px-4 py-14 sm:px-6" data-pagefind-body>
    <p class="kicker">Event tracker · {d.status === 'ongoing' ? 'Ongoing' : 'Settled'}</p>
    <h1 class="mt-3 font-display text-3xl font-bold leading-tight tracking-tight sm:text-5xl">{d.title}</h1>
    <p class="mt-5 text-lg leading-relaxed text-muted">{d.summary}</p>
    <dl class="mt-8 grid grid-cols-2 gap-4 rounded-2xl border border-line bg-surface p-5 font-mono text-xs sm:grid-cols-4" data-pagefind-ignore>
      <div><dt class="text-muted">Events</dt><dd class="mt-1 font-display text-2xl font-semibold text-ink">{tracker.sorted.length}</dd></div>
      <div><dt class="text-muted">Organisations</dt><dd class="mt-1 font-display text-2xl font-semibold text-ink">{actors.length}</dd></div>
      <div><dt class="text-muted">Started</dt><dd class="mt-1 text-sm text-ink">{formatDate(d.startedOn)}</dd></div>
      <div><dt class="text-muted">Last checked</dt><dd class="mt-1 text-sm text-ink">{formatDate(d.lastChecked)}</dd></div>
    </dl>
    <ul class="mt-5 flex flex-wrap gap-x-4 gap-y-2 text-xs text-muted" aria-label="Legend" data-pagefind-ignore>
      {usedTypes.map((k) => <li class="flex items-center gap-1.5"><span class="h-2 w-2 rounded-full" style={`background:${EVENT_TYPES[k].color}`}></span>{EVENT_TYPES[k].label}</li>)}
      <li class="flex items-center gap-1.5"><span class="rounded-full border border-line px-1.5 font-mono text-[0.65rem] uppercase">Reported</span>anonymous or second-hand sourcing</li>
    </ul>
    <Timeline entries={tracker.sorted} />
    {d.status === 'ongoing' && (
      <p class="mt-4 rounded-xl border border-dashed border-line p-4 text-sm text-muted">This story is still developing. We re-check it twice a week and add every new action that is confirmed by at least two sources.</p>
    )}
    {related.length > 0 && (
      <section class="mt-12" data-pagefind-ignore>
        <h2 class="font-display text-lg font-semibold">Read the analysis</h2>
        <ul class="mt-3 space-y-2">{related.map((p) => <li><a class="text-cyan hover:underline" href={`/posts/${p!.id}/`}>{p!.data.title}</a></li>)}</ul>
      </section>
    )}
  </article>
</Base>
