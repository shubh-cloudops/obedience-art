---
import Base from '../layouts/Base.astro';
// Add a row here (newest first) whenever a published post is corrected.
const corrections: { date: string; post: string; href: string; change: string }[] = [];
---
<Base title="Corrections log" description="Every correction made to a published Obedience ART post, newest first.">
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <p class="kicker">Standards</p>
    <h1 class="mt-3 font-display text-4xl font-bold tracking-tight">Corrections log</h1>
    <p class="mt-4 text-muted">A site that checks other people's claims should show its own mistakes. If you spot an error, comment on the post or open an issue on GitHub.</p>
    {corrections.length === 0 ? (
      <p class="card mt-10 p-6 text-muted">No corrections yet.</p>
    ) : (
      <ul class="mt-10 space-y-4">
        {corrections.map((c) => (
          <li class="card p-5"><p class="font-mono text-xs text-muted">{c.date}</p><a class="mt-1 block font-semibold text-cyan" href={c.href}>{c.post}</a><p class="mt-1 text-sm">{c.change}</p></li>
        ))}
      </ul>
    )}
  </section>
</Base>
