---
// Comments through GitHub Discussions. Values come from giscus.app after Discussions is enabled.
const cfg = {
  repo: import.meta.env.PUBLIC_GISCUS_REPO,
  repoId: import.meta.env.PUBLIC_GISCUS_REPO_ID,
  category: import.meta.env.PUBLIC_GISCUS_CATEGORY ?? 'Announcements',
  categoryId: import.meta.env.PUBLIC_GISCUS_CATEGORY_ID,
};
const ready = Boolean(cfg.repo && cfg.repoId && cfg.categoryId);
---
<section data-art="eager" data-art-say="You made it to the end! What do you think?" aria-label="Comments" class="mt-16 border-t border-line pt-10">
  <h2 class="font-display text-lg font-semibold">Discussion</h2>
  {ready ? (
    <div class="giscus mt-6" data-cfg={JSON.stringify(cfg)}></div>
  ) : (
    <p class="mt-3 text-sm text-muted">Comments switch on once the Giscus settings are added (README, step "Comments").</p>
  )}
</section>
<script>
  const el = document.querySelector<HTMLElement>('.giscus[data-cfg]');
  const themeFor = (t?: string) => (t === 'light' ? 'light' : 'dark_dimmed');
  if (el) {
    const cfg = JSON.parse(el.dataset.cfg!);
    const s = document.createElement('script');
    s.src = 'https://giscus.app/client.js';
    s.async = true;
    s.crossOrigin = 'anonymous';
    Object.entries({
      repo: cfg.repo, 'repo-id': cfg.repoId, category: cfg.category, 'category-id': cfg.categoryId,
      mapping: 'pathname', strict: '1', 'reactions-enabled': '1', 'emit-metadata': '0',
      'input-position': 'top', theme: themeFor(document.documentElement.dataset.theme), lang: 'en', loading: 'lazy',
    }).forEach(([k, v]) => s.setAttribute(`data-${k}`, v));
    el.after(s);
    window.addEventListener('themechange', (e) => {
      const frame = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
      frame?.contentWindow?.postMessage({ giscus: { setConfig: { theme: themeFor((e as CustomEvent).detail) } } }, 'https://giscus.app');
    });
  }
</script>
