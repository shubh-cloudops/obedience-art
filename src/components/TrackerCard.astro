---
import type { Tracker } from '../lib/events';
import { formatDate } from '../lib/format';
interface Props { tracker: Tracker; compact?: boolean }
const { tracker, compact = false } = Astro.props;
const d = tracker.data;
const latest = tracker.sorted.at(-1)!;
// Inside an article (compact) the card is a link, not a section, so its title is not a heading.
const Title = compact ? 'p' : 'h3';
---
<a href={`/tracker/${tracker.id}/`} class="card group block p-6">
  <div class="flex flex-wrap items-center gap-3">
    <span class="kicker">Event tracker</span>
    {d.status === 'ongoing'
      ? <span class="inline-flex items-center gap-1.5 font-mono text-[0.7rem] uppercase tracking-wide text-green"><span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green motion-reduce:animate-none" aria-hidden="true"></span>Ongoing</span>
      : <span class="font-mono text-[0.7rem] uppercase tracking-wide text-muted">Settled</span>}
  </div>
  <Title class="mt-3 font-display text-xl font-semibold leading-snug group-hover:text-cyan">{d.title}</Title>
  {!compact && <p class="mt-2 text-sm leading-relaxed text-muted">{d.summary}</p>}
  <p class="mt-4 text-sm"><span class="text-muted">Latest:</span> {latest.actor}: {latest.title}</p>
  <p class="mt-4 font-mono text-xs text-muted">{tracker.sorted.length} events · last checked {formatDate(d.lastChecked)}</p>
</a>
