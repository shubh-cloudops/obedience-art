# Copy to .env for local testing. Never commit .env.
# In GitHub these are repository *variables* (Settings > Secrets and variables > Actions > Variables),
# not secrets: they are public IDs that end up in the page HTML anyway.

# Full site URL, used for canonical links, RSS and sitemap.
SITE_URL=https://obedienceart.com

# Cloudflare Web Analytics token (Cloudflare dashboard > Analytics & Logs > Web Analytics).
PUBLIC_CF_BEACON_TOKEN=

# Giscus comments (values from https://giscus.app after Discussions is enabled).
PUBLIC_GISCUS_REPO=shubh-cloudops/obedience-art
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=Announcements
PUBLIC_GISCUS_CATEGORY_ID=

# Buttondown username for the email signup (free up to 100 subscribers). Empty = show RSS link instead.
PUBLIC_BUTTONDOWN_USER=
